// TODO: Some day use eslint-plugin-angular
// https://github.com/Gillespie59/eslint-plugin-angular
{
  "env": {
    "commonjs": true,
    "browser": true,
    "node": false,
    "jasmine": true
  },
  "rules": {
    // TODO: these four need code changes rather than a --fix pass
    "no-unused-vars": 0,
    "lines-around-comment": 0,
    "no-use-before-define": 0,
    "new-cap": 0
  },
  "globals": {
    "angular": 1,
    "inject": 1,
    "waitUrl": 1
  }
}
