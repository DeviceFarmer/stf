#: res/app/src/core/install.ts:171
msgid "The new package failed because it contains a content provider with thesame authority as a provider already installed in the system."
msgstr "Не вдалося встановити новий пакет, оскільки він містить постачальника вмісту з таким самим authority, як у вже встановленого в системі постачальника."

#: res/app/src/core/install.ts:173
msgid "The new package failed because it has specified that it is a test-only package and the caller has not supplied the INSTALL_ALLOW_TEST flag."
msgstr "Не вдалося встановити новий пакет, оскільки він позначений як пакет лише для тестування, а програма, що викликає, не передала прапорець INSTALL_ALLOW_TEST."

#: res/app/src/core/install.ts:172
msgid "The new package failed because the current SDK version is newer than that required by the package."
msgstr "Не вдалося встановити новий пакет, оскільки поточна версія SDK новіша, ніж вимагає пакет."

#: res/app/src/core/install.ts:170
msgid "The new package failed because the current SDK version is older than that required by the package."
msgstr "Не вдалося встановити новий пакет, оскільки поточна версія SDK старіша, ніж вимагає пакет."

#: res/app/src/core/install.ts:169
msgid "The new package failed while optimizing and validating its dex files, either because there was not enough storage or the validation failed."
msgstr "Не вдалося встановити новий пакет під час оптимізації та перевірки його DEX-файлів: недостатньо місця для зберігання або перевірка не вдалася."

#: res/app/src/core/install.ts:183
